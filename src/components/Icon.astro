} from '@lucide/astro';

interface Props {
  name: string;
  class?: string;
  size?: number;
}

const iconMap: Record<string, any> = {
  'arrow-right': ArrowRight,
  'award': Award,
  'bot': Bot,
  'box': Box,
  'brain': Brain,
  'calendar': Calendar,
  'camera': Camera,
  'check': Check,
  'chevron-right': ChevronRight,
  'chevrons-down': ChevronsDown,
  'clock': Clock,
  'code': Code,
  'copy': Copy,
  'database': Database,
  'download': Download,
  'eye': Eye,
  'file-text': FileText,
  'github': Github,
  'inbox': Inbox,
  'layout': Layout,
  'mail': Mail,
  'menu': Menu,
  'message-circle': MessageCircle,
  'message-square': MessageSquare,
  'network': Network,
  'play': Play,
  'play-circle': PlayCircle,
  'presentation': Presentation,
  'rocket': Rocket,
  'search': Search,
  'shield': Shield,
  'shield-alert': ShieldAlert,
  'sparkles': Sparkles,
  'target': Target,
  'terminal': Terminal,
  'trending-up': TrendingUp,
  'type': Type,
  'user': User,
  'users': Users,
  'wrench': Wrench,
  'x': X,
  'zap': Zap,
  'activity': Activity,
  'binary': Binary,
  'blocks': Blocks,
  'book-open': BookOpen,
  'boxes': Boxes,
  'braces': Braces,
  'building': Building,
  'chart-bar': ChartBar,
  'chart-line': ChartLine,
  'chart-scatter': ChartScatter,
  'coins': Coins,
  'compass': Compass,
  'cpu': Cpu,
  'credit-card': CreditCard,
  'crosshair': Crosshair,
  'flask-conical': FlaskConical,
  'gauge': Gauge,
  'git-branch': GitBranch,
  'hotel': Hotel,
  'layers': Layers,
  'lightbulb': Lightbulb,
  'message-square-text': MessageSquareText,
  'microscope': Microscope,
  'puzzle': Puzzle,
  'radar': Radar,
  'repeat': Repeat,
  'scale': Scale,
  'shopping-cart': ShoppingCart,
  'sigma': Sigma,
  'sliders-horizontal': SlidersHorizontal,
  'split': Split,
  'table': Table,
  'timer': Timer,
  'trending-down': TrendingDown,
  'trees': Trees,
  'trophy': Trophy,
  'video': Video,
  'wand': Wand,
  'waypoints': Waypoints,
};

const { name, class: className, size } = Astro.props;
const IconComponent = iconMap[name];
---

{IconComponent ? (
  <IconComponent class={className} size={size} />
) : (
  <span class={className} title={`Unknown icon: ${name}`}>?</span>
)}

---
import '../assets/styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Footer from '../components/Footer.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  navBrand?: string;
}

const { title, description, navBrand } = Astro.props;

const siteLinks: { label: string; href: string; accent?: 'graduate' }[] = [
  { label: 'Start Here', href: '/start' },
  { label: 'Python', href: '/python' },
  { label: 'Sessions', href: '/sessions' },
  { label: 'Syllabus', href: '/syllabus' },
  { label: 'Explorers', href: '/explorers' },
  { label: 'Practice', href: '/practice' },
  { label: 'Cheat Sheet', href: '/cheatsheet' },
  { label: 'Project', href: '/project' },
];

// Build search index
const sessions = await getCollection('sessions');
const sorted = sessions.sort((a, b) => a.data.number - b.data.number);

const searchIndex: { type: string; title: string; subtitle?: string; url: string; tags?: string[]; sessionTitle?: string }[] = [];

for (const session of sorted) {
  const d = session.data;
  const url = `/sessions/${d.slug}`;
  const numStr = String(d.number).padStart(2, '0');
  const sessionLabel = `Session ${numStr}`;

  searchIndex.push({
    type: 'session',
    title: `${sessionLabel}: ${d.title}`,
    subtitle: d.subtitle,
    url,
    tags: d.tags,
  });

  for (const obj of d.objectives || []) {
    searchIndex.push({
      type: 'objective',
      title: obj.title,
      subtitle: obj.description,
      url: `${url}#objectives`,
      sessionTitle: sessionLabel,
    });
  }

  for (const res of d.resources || []) {
    searchIndex.push({
      type: 'resource',
      title: res.title,
      subtitle: res.description,
      url: res.url,
      sessionTitle: sessionLabel,
    });
  }
}

searchIndex.push({
  type: 'explorer',
  title: 'Explorers — interactive machine learning',
  subtitle: 'Overfitting, threshold & profit, gradient boosting, conformal, k-means',
  url: '/explorers',
});

searchIndex.push({
  type: 'practice',
  title: 'Practice — Predictive analytics question bank',
  subtitle: '36 exam-style questions with misconception-tagged answers',
  url: '/practice',
});

searchIndex.push({ type: 'guide', title: 'Python Foundations — the four decks from Sessions 1–2, and Lab 0', subtitle: 'Variables, conditionals, functions, loops: what we covered, what you should be able to do, worked churn examples, the self-checking Lab 0', url: '/python/foundations/' });
searchIndex.push({ type: 'guide', title: 'Start Here — your first 30 minutes', subtitle: 'Setup, how each week works, how to use the site', url: '/start' });
searchIndex.push({ type: 'guide', title: 'Python Track — from zero to pandas, with a browser playground', subtitle: 'Eight levels: expressions, conditionals, functions, loops, strings, files, lists, dictionaries, tuples, HTTP, pandas, visualization, first scikit-learn', url: '/python' });
searchIndex.push({ type: 'guide', title: 'Cheat Sheet — the whole course on one page', subtitle: 'Framing, leakage test, pipeline template, metric menu, threshold formula, CV chooser, trust checklist', url: '/cheatsheet' });
searchIndex.push({ type: 'guide', title: 'Datasets — every dataset with a no-login loader', subtitle: 'Telco, hotel bookings, Ames, credit default, bank marketing, retail, bikes, reviews', url: '/datasets' });
searchIndex.push({ type: 'resource', title: 'Resources hub — every link from every session', subtitle: 'Readings, videos, tools, stories', url: '/resources' });
searchIndex.push({
  type: 'project',
  title: 'Your Prediction Story — Final Project',
  subtitle: 'Pick a real prediction problem. Model it. Decide with it. Present Dec 14.',
  url: '/project',
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} />
</head>
<body>
  <NeuralBackground />
  <Navbar brand={navBrand} links={siteLinks} />
  <MobileMenu links={siteLinks} />
  <SearchDialog searchIndex={searchIndex} />
  <main class="pt-[72px]">
    <slot />
  </main>
  <Footer />

  <script is:inline>
    // Fade-in observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>
</body>
</html>

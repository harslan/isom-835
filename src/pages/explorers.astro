---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientText from '../components/GradientText.astro';
import Icon from '../components/Icon.astro';

const explorers = [
  {
    title: 'The Overfitting Explorer',
    tagline: 'Bias, variance & noise · the sweet spot, live',
    href: '/explore/',
    icon: 'sliders-horizontal',
    session: 'Sessions 1 & 4 · Sep 14 & Oct 5',
    slug: 'session-01',
    description: 'A hidden demand curve seen through noisy weeks. Drag the polynomial degree and watch training error fall forever while test error turns back up — then add data, cut noise, and resample to see which cures work.',
    concepts: ['Train vs. test error', 'Bias–variance trade-off', 'Overfitting', 'More data as regularizer'],
  },
  {
    title: 'The Leakage Time Machine',
    tagline: 'When did you know that? · drag the prediction moment',
    href: '/explore/leakage/',
    icon: 'timer',
    session: 'Session 2 · Sep 21',
    slug: 'session-02',
    description: 'A real model retrained at each moment on a timeline — a bank\'s phone campaign, a hotel\'s bookings. Drag the moment a prediction is made and watch which columns exist yet, how good the model looks, and whether there is still a decision left to make. The one question that catches every leak, made draggable.',
    concepts: ['Target leakage', 'Prediction moment', 'Features known at decision time', 'Why a perfect score is a bug report'],
  },
  {
    title: 'The Threshold & Profit Explorer',
    tagline: 'From scores to decisions · price the mistakes',
    href: '/explore/threshold/',
    icon: 'coins',
    session: 'Session 6 · Oct 26',
    slug: 'session-06',
    description: 'Two overlapping score distributions, a draggable cutoff, a live confusion matrix, ROC curve, and profit curve. Change the offer cost, the value of a save, or the contact budget and watch the best threshold walk away from 0.5.',
    concepts: ['Confusion matrix', 'Precision & recall', 'Expected value', 'Profit vs. accuracy'],
  },
  {
    title: 'The Gradient Boosting Explorer',
    tagline: 'Fit the residuals · early stopping as a picture',
    href: '/explore/boosting/',
    icon: 'trending-up',
    session: 'Session 8 · Nov 9',
    slug: 'session-08',
    description: 'Start from a flat guess and add one tiny tree at a time, each fit to what the ensemble still gets wrong. Drag the learning rate and depth, step through the ensemble, and watch held-out error bottom out and turn back up — the point where early stopping stops.',
    concepts: ['Residual fitting', 'Learning rate × trees', 'Weak learners', 'Early stopping'],
  },
  {
    title: 'The Conformal Explorer',
    tagline: 'Uncertainty · intervals that keep their promise',
    href: '/explore/conformal/',
    icon: 'shield',
    session: 'Session 9 · Nov 16',
    slug: 'session-09',
    description: 'A model, a calibration set, and a 90% band sized by the 90th-percentile residual. Draw new cases a hundred times and watch coverage settle on the target — then underfit the model, shrink the calibration set, or shift the data and see which promises survive.',
    concepts: ['Calibration residuals', 'Coverage guarantee', 'Exchangeability', 'Adaptive bands'],
  },
  {
    title: 'The K-Means Explorer',
    tagline: 'Learning without labels · step the algorithm',
    href: '/explore/kmeans/',
    icon: 'boxes',
    session: 'Session 10 · Nov 23',
    slug: 'session-10',
    description: 'Customers on a recency × frequency plane. Place centroids, step assignment and update one iteration at a time, compare k-means++ to random starts, read the elbow and silhouette — and catch k-means inventing segments in a single blob.',
    concepts: ['Centroids & assignment', 'Inertia & elbow', 'Silhouette', 'Choosing k'],
  },
];

const comingSoon: { title: string; session: string; description: string }[] = [];
---

<BaseLayout title="ISOM 835 | Explorers — Interactive Machine Learning">
  <section class="py-24 px-8 max-w-[1200px] mx-auto">
    <div class="text-center mb-16">
      <div class="font-mono text-[0.75rem] text-accent-cyan tracking-[3px] uppercase mb-6">
        Touch the theory
      </div>
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold mb-4">
        The <GradientText>Explorers</GradientText>
      </h1>
      <p class="text-text-secondary text-lg max-w-[680px] mx-auto">
        Every big idea in this course gets a living, draggable version. No installation, no login —
        open one on your phone during class or at midnight before the project is due. If you can predict what
        the picture will do before you drag, you understand the concept.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {explorers.map((e) => (
        <a href={e.href} class="group block bg-bg-card border border-border-subtle rounded-2xl p-8 no-underline text-inherit transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_0_60px_rgba(46,230,197,0.15)] fade-in">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-cyan/20 to-accent-purple/20 flex items-center justify-center">
              <Icon name={e.icon} class="w-6 h-6 text-accent-cyan" />
            </div>
            <div>
              <h2 class="text-xl font-bold transition-colors duration-300 group-hover:text-accent-cyan">{e.title}</h2>
              <div class="font-mono text-[0.7rem] text-text-muted tracking-wide">{e.tagline}</div>
            </div>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed mb-5">{e.description}</p>
          <div class="flex gap-2 flex-wrap mb-5">
            {e.concepts.map((c) => (
              <span class="px-3 py-1 bg-accent-purple/10 rounded-full text-[0.7rem] text-accent-purple">{c}</span>
            ))}
          </div>
          <div class="flex items-center justify-between">
            <span class="font-mono text-[0.72rem] text-text-muted">{e.session}</span>
            <span class="font-mono text-[0.8rem] text-accent-cyan transition-transform duration-300 group-hover:translate-x-1">
              Open →
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2" class:list={[comingSoon.length === 0 && 'hidden']}>
      {comingSoon.map((e) => (
        <div class="bg-bg-card/50 border border-dashed border-border-subtle rounded-2xl p-7 fade-in">
          <div class="font-mono text-[0.65rem] text-text-muted tracking-[2px] uppercase mb-2">Coming · {e.session}</div>
          <h3 class="text-lg font-semibold text-text-secondary mb-1">{e.title}</h3>
          <p class="text-text-muted text-sm">{e.description}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

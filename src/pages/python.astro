---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientText from '../components/GradientText.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';

const GH = 'https://colab.research.google.com/github/harslan/isom-835/blob/master/public/';
const SL = '/python/slides/';

type Link = { t: string; u: string; k: 'slides' | 'lecture' | 'exercise' | 'challenge' | 'web' | 'video' | 'read'; d?: string };
type Level = { n: number; title: string; time: string; icon: string; blurb: string; can: string[]; links: Link[]; practice: string };

const levels: Level[] = [
  {
    n: 0, title: 'Setup & your first notebook', time: '30 min', icon: 'rocket',
    blurb: 'Colab is a Python notebook in your browser: cells you run one at a time, text and code side by side. Learn the five keystrokes you will use ten thousand times.',
    can: ['Open a Colab notebook, run a cell (Shift+Enter), add a cell, save a copy to Drive', 'Read an error message from the bottom up', 'Print, comment, and ask Colab\'s assistant for help — then verify what it wrote'],
    links: [
      { t: 'Python, Guided — Lesson 0 (read, run, get graded)', u: '/python/playground/#L0', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Module 0 — introduction activity (Prof. Arslan)', u: GH + 'python/modules/module_0_introduction_activity_ha.ipynb', k: 'lecture', d: 'A ten-minute first notebook: run, edit, break, fix.' },
      { t: 'Python Tutor — visualize code line by line', u: 'https://pythontutor.com/', k: 'web', d: 'Paste any short program and watch variables change step by step. The single best tool for understanding what a loop does.' },
      { t: 'Kaggle Learn — Python', u: 'https://www.kaggle.com/learn/python', k: 'web', d: 'Seven short lessons with exercises, no setup. If you have never written Python, start here tonight.' },
    ],
    practice: 'Python, Guided — Lesson 0.',
  },
  {
    n: 1, title: 'Python foundations', time: '3–4 hours', icon: 'braces',
    blurb: 'Expressions, variables, and types; conditionals and try/except; functions with arguments and return values; while and for loops with break and continue. Everything else in the course is built from these.',
    can: ['Write numeric expressions and understand operator precedence', 'Direct control flow with if / elif / else and handle errors with try / except', 'Define and reuse functions with any number of arguments; know when a function returns nothing', 'Automate repetition with definite (for) and indefinite (while) loops'],
    links: [
      { t: 'Python, Guided — Lesson 1 (read, run, get graded)', u: '/python/playground/#L1', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Slides 02 — Expressions & variables', u: 'https://docs.google.com/presentation/d/1BhnjBMYBJE-ygO7oqQ6mqpjjsq7yGrM-mUtk4V2I6ak/edit', k: 'slides' },
      { t: 'Slides 03 — Conditional execution', u: 'https://docs.google.com/presentation/d/15yQnTeDlQS7HdW624kpUOTJ5lMcBJqTVISYlg6JMtS4/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 04 — Functions', u: 'https://docs.google.com/presentation/d/1RozruN78lQ1mjkayM1LpXdm4OnP5sYKfNKgA-nupCoc/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 05 — Iterations', u: 'https://docs.google.com/presentation/d/1_ilvYR-64GgHYfpfJSzSsje-o4LJwQFIXvyTP7E9jzI/edit?usp=sharing', k: 'slides' },
      { t: 'Lecture notebook — Introduction to Python (Fall 2025)', u: 'https://colab.research.google.com/drive/11Ik3-OS_6pT2vLPioREZUaj81grpWUq4?usp=sharing', k: 'lecture' },
      { t: 'Lecture notebook — Loops, iterations, functions (Fall 2025)', u: 'https://colab.research.google.com/drive/1ginQrL7K-Ei1bi-tpuYMY7UWo1G_j8gf?usp=sharing', k: 'lecture' },
      { t: 'Module 1 exercises', u: GH + 'python/modules/module_1_exercises.ipynb', k: 'exercise', d: 'Three questions on expressions, conditionals, and loops.' },
      { t: 'Module 1 challenge', u: GH + 'python/modules/module_1_challenge_question.ipynb', k: 'challenge' },
      { t: 'py4e — Python for Everybody (Severance)', u: 'https://www.py4e.com/lessons', k: 'web', d: 'The free course these slides descend from: videos, a free book, and autograded exercises for every chapter.' },
      { t: 'CS Circles — Waterloo\'s interactive Python', u: 'https://cscircles.cemc.uwaterloo.ca/', k: 'web', d: 'Short lessons with exercises graded in the browser. Excellent for loops and functions.' },
      { t: 'Python docs — The official tutorial, chapters 3–4', u: 'https://docs.python.org/3/tutorial/', k: 'read', d: 'When you want the precise rule, not a metaphor.' },
    ],
    practice: 'Python, Guided — Lesson 1 (six exercises, ending with FizzBuzz).',
  },
  {
    n: 2, title: 'Strings, files & lists', time: '3 hours', icon: 'type',
    blurb: 'Objects carry data and methods. Strings and lists are the first two you will use in every notebook; files are the memory that outlives your program.',
    can: ['Slice, search, and format strings; use the built-in string methods with confidence', 'Open, read, and iterate a text file line by line', 'Build, index, slice, sort, and mutate lists; use list methods and comprehensions'],
    links: [
      { t: 'Python, Guided — Lesson 2 (read, run, get graded)', u: '/python/playground/#L2', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Slides 06 — Strings', u: 'https://docs.google.com/presentation/d/1DThGm0zjYYvT9wUs3W0H9RyUe0QA9BzqAa2hwnw23Nw/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 07 — Files', u: 'https://docs.google.com/presentation/d/1mtYt3cHV3CrOlSJ-LdJh1u3AIODpVOfiI4XUVVsI56I/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 08 — Lists', u: 'https://docs.google.com/presentation/d/1jx2T3azmpk7b_2BpL2KpfCKtdHuc-eg_LHIQgAvj06I/edit?usp=sharing', k: 'slides' },
      { t: 'Practice questions (slides) — Module 2', u: 'https://docs.google.com/presentation/d/1K_8lnCQxiM6pSp_FLIy588FYuAPgqlrgfZnbYnFgqBs/edit?usp=sharing', k: 'slides', d: 'Five questions on Module 1 material, plus an introduction to HackerRank\'s Python track.' },
      { t: 'Lecture notebook — Lists & dictionaries (Fall 2025)', u: 'https://colab.research.google.com/drive/10G1ON-vsQ4O-822o4hBXVSk9OGjQ4yzf?usp=sharing', k: 'lecture' },
      { t: 'Module 2 exercises', u: GH + 'python/modules/module_2_exercises.ipynb', k: 'exercise', d: 'Strings, reading a file line by line, lists with loops.' },
      { t: 'Module 2 challenge — sum of primes below 5,000', u: GH + 'python/modules/module_2_challenge_question.ipynb', k: 'challenge' },
      { t: 'W3Schools — Python string formatting & list methods', u: 'https://www.w3schools.com/python/python_string_formatting.asp', k: 'read', d: 'The quickest reference on the web; the list-methods page is one click away.' },
      { t: 'Automate the Boring Stuff — Chapters 6 and 9', u: 'https://automatetheboringstuff.com/', k: 'read', d: 'Free book. Strings and files, taught through tasks you actually want to automate.' },
    ],
    practice: 'Python, Guided — Lesson 2.',
  },
  {
    n: 3, title: 'Dictionaries, tuples & the web', time: '3 hours', icon: 'layers',
    blurb: 'A dictionary is a set of counters — the idiom behind every "rate by group" you will compute. Tuples are hashable and comparable, so you can sort lists of them and use them as keys. Then Python pretends to be a browser.',
    can: ['Count frequencies with a dictionary and the .get(key, 0) idiom; iterate keys, values, and items', 'Sort a list of tuples by any field; use tuples as dictionary keys', 'Retrieve a web page with urllib / requests and parse it with BeautifulSoup'],
    links: [
      { t: 'Python, Guided — Lesson 3 (read, run, get graded)', u: '/python/playground/#L3', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Slides 09 — Dictionaries', u: 'https://docs.google.com/presentation/d/1o23qN6ml0QryraZrAyOU8eQ6ge4ANb9FnyaEmOs7tcA/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 10 — Tuples', u: 'https://docs.google.com/presentation/d/1a1_14wN0eG2BKM1Vs6JkjrBb5RzhFWMyLjU0i8Zaep4/edit?usp=sharing', k: 'slides' },
      { t: 'Slides 12 — HTTP & scraping', u: 'https://docs.google.com/presentation/d/1HXtAYe-fARgh9Mo322w1zvX56238dehcq0vy4ccIw1k/edit?usp=sharing', k: 'slides' },
      { t: 'Module 3 lecture notebook — dictionaries as counters, top-10 words', u: GH + 'python/modules/Module3_lecture_notebook.ipynb', k: 'lecture', d: 'The hotel dictionary, counting names, the most-common-word program, sorting tuples.' },
      { t: 'Module 3 exercises', u: GH + 'python/modules/module_3_exercises.ipynb', k: 'exercise', d: 'Strings + dictionaries, tuples + dictionaries, scraping a static page.' },
      { t: 'Module 3 challenge — FizzBuzz', u: GH + 'python/modules/module_3_challenge_question.ipynb', k: 'challenge', d: 'The classic interview question. Simple, and tricky for some.' },
      { t: 'API call — Polygon.io financial data (Fall 2025)', u: 'https://colab.research.google.com/drive/1vKSs3OGdkeC6yB0VT7Gl9GBiJ5N-bT4g?usp=sharing', k: 'lecture', d: 'A real REST API: request, JSON, DataFrame.' },
      { t: 'Whirlwind Tour of Python (VanderPlas) — Data structures', u: 'https://jakevdp.github.io/WhirlwindTourOfPython/', k: 'read', d: 'A free, fast, precise tour for people who already program in something else.' },
      { t: 'regex101', u: 'https://regex101.com/', k: 'web', d: 'When you need to pull a pattern out of messy text, test the regular expression here first.' },
    ],
    practice: 'Python, Guided — Lesson 3 (ends with rate-by-group by hand).',
  },
  {
    n: 4, title: 'pandas: working with data', time: '4–6 hours', icon: 'table',
    blurb: 'The library the whole course runs on. Read a CSV, look at it, select rows and columns, summarize, group, merge — and clean the column that was secretly a string.',
    can: ['Load data from CSV, Excel, URLs, and APIs into a DataFrame', 'Select with .loc / .iloc and boolean masks; add and transform columns', 'Summarize with describe / value_counts; aggregate with groupby; combine tables with merge', 'Recognize the three merge shapes (one-to-one, many-to-one, many-to-many) and check row counts'],
    links: [
      { t: 'Python, Guided — Lesson 4 (read, run, get graded)', u: '/python/playground/#L4', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Module 4 lecture notebook — exploratory data analysis with pandas (Prof. Arslan)', u: GH + 'refreshers/m4_2_exploratory_data_analysis.ipynb', k: 'lecture', d: 'Series and DataFrames, indexing, summaries, groupby, and the three kinds of joins.' },
      { t: 'pandas library introduction (slides)', u: 'https://drive.google.com/file/d/19SVPgPfpO8ubHLfVcUdZkw-ot2CmHLBD/view?usp=sharing', k: 'slides' },
      { t: 'Slides 13 — Web services & APIs', u: 'https://docs.google.com/presentation/d/1FQXE_YXzT3TWUILmz-ne7yUrlXgFtDg_MQJssOhcckM/edit?usp=sharing', k: 'slides' },
      { t: 'Module 4 exercises', u: 'https://colab.research.google.com/drive/1dURjAVxphmUXFl_tiVvMNkF-THq8iL8f', k: 'exercise', d: 'A headless-browser scrape, then two pandas questions.' },
      { t: 'Module 4 challenge — Olympic medals 1896–2014', u: 'https://colab.research.google.com/drive/1EEbFcca3vAbNfr0Syx_jmnVlgf6cHW2z', k: 'challenge', d: '35,000 medals; the best pandas workout in the archive.' },
      { t: 'Pandas exercises (Prof. Arslan\'s Drive folder)', u: 'https://drive.google.com/drive/u/0/folders/1Jtj3SavgqN48dInDig3ElkBVfTZ6_etx', k: 'exercise', d: 'Chipotle, occupations, and friends — the guipsamora set, curated.' },
      { t: 'guipsamora/pandas_exercises (GitHub)', u: 'https://github.com/guipsamora/pandas_exercises', k: 'exercise', d: 'The original repository: 15 topics, each with an exercise notebook and a solution notebook.' },
      { t: 'pandas — 10 minutes to pandas', u: 'https://pandas.pydata.org/docs/user_guide/10min.html', k: 'read' },
      { t: 'pandas cheat sheet (PDF)', u: 'https://pandas.pydata.org/Pandas_Cheat_Sheet.pdf', k: 'read', d: 'Two pages. Print it.' },
      { t: 'pandas for spreadsheet users', u: 'https://pandas.pydata.org/docs/getting_started/comparison/comparison_with_spreadsheets.html', k: 'read', d: 'Every Excel habit, translated.' },
      { t: 'Kaggle Learn — Pandas', u: 'https://www.kaggle.com/learn/pandas', k: 'web', d: 'Six lessons with exercises on a wine-reviews dataset.' },
      { t: 'McKinney — Python for Data Analysis, 3rd ed. (free online)', u: 'https://wesmckinney.com/book/', k: 'read', d: 'By the creator of pandas. Chapters 5–8 are the reference for this level.' },
    ],
    practice: 'Python, Guided — Lesson 4 (six pandas exercises), then Session 2\'s notebook.',
  },
  {
    n: 5, title: 'Visualization', time: '2 hours', icon: 'chart-scatter',
    blurb: 'A chart is an argument. matplotlib draws anything; seaborn draws the statistical charts you need with one call and integrates with DataFrames.',
    can: ['Make and label line, bar, scatter, and histogram charts in matplotlib; save a figure', 'Use seaborn for distributions, pair plots, categorical comparisons, and heatmaps', 'Choose the chart that answers the question, and title it with the answer'],
    links: [
      { t: 'Module 5 lecture — data visualization with matplotlib & seaborn (Prof. Arslan)', u: GH + 'refreshers/m5_1_data_visualizations_with_python.ipynb', k: 'lecture' },
      { t: 'Seaborn examples in Python (Fall 2025)', u: 'https://colab.research.google.com/drive/1YkKOYnUTIJ_bLIjpP9l-dqanLxzH2q4l?usp=sharing', k: 'lecture' },
      { t: 'Module 5 exercises', u: GH + 'python/modules/module5_exercises.ipynb', k: 'exercise', d: 'Bar plots, scatter plots, pair plots — when and why.' },
      { t: 'Module 5 challenge — top-rated movie directors', u: GH + 'python/modules/module5_challenge_question_finding_top_rated_movie_directors.ipynb', k: 'challenge' },
      { t: 'Seaborn tutorial', u: 'https://seaborn.pydata.org/tutorial.html', k: 'read' },
      { t: 'Matplotlib cheat sheets', u: 'https://matplotlib.org/cheatsheets/', k: 'read', d: 'Official, two pages, everything.' },
    ],
    practice: 'Re-make three charts from Session 2 with seaborn.',
  },
  {
    n: 6, title: 'First scikit-learn', time: '3 hours', icon: 'target',
    blurb: 'Choose a model, set its hyperparameters, arrange X and y, fit, predict. The estimator API is the same for every model in the course — learn it once here at a gentle pace, then Session 1 moves fast.',
    can: ['Arrange a features matrix and a target vector; split train and test', 'Fit and evaluate a model with the scikit-learn estimator API', 'Recognize overfitting and use a validation set or cross-validation'],
    links: [
      { t: 'Python, Guided — Lesson 5 (read, run, get graded)', u: '/python/playground/#L5', k: 'web', d: 'Start here: the lesson, runnable examples, and graded exercises, all in the browser.' },
      { t: 'Introducing scikit-learn (Prof. Arslan)', u: GH + 'refreshers/m5_2_introducing_scikit_learn_library.ipynb', k: 'lecture' },
      { t: 'Model validation & selection (Prof. Arslan)', u: GH + 'refreshers/m5_3_model_validation_and_model_selection.ipynb', k: 'lecture' },
      { t: 'Introduction to scikit-learn (Fall 2025 Colab)', u: 'https://colab.research.google.com/drive/1ddkZPgzCHVZ9zCGBYjoX04n8YOGffCzG', k: 'lecture' },
      { t: 'Module 6 exercises — Naive Bayes, SVM, lasso on scikit-learn datasets', u: GH + 'python/modules/module6_exercises.ipynb', k: 'exercise' },
      { t: 'Neural Numbers — train a digit recognizer in your browser', u: 'https://imaginary.github.io/neural-numbers/index.html', k: 'web', d: 'Draw a digit, watch the network guess, then train it yourself. Pure delight.' },
      { t: 'Kaggle — Titanic tutorial: how a competition works', u: 'https://www.kaggle.com/code/alexisbcook/titanic-tutorial', k: 'web', d: 'Your first submission, step by step — the muscle memory you need for the midterm competition.' },
    ],
    practice: 'Python, Guided — Lesson 5 trains a model in the browser. Then start Session 1.',
  },
];

const arenas = [
  { t: 'Python, Guided (this site)', u: '/python/playground/', d: 'Seven lessons, runnable examples, 27 graded exercises, and a first scikit-learn model — all in the browser. Start here.' },
  { t: 'futurecoder', u: 'https://futurecoder.io/', d: 'A free, interactive, step-by-step Python course with a built-in debugger. The best "from zero" experience on the web.' },
  { t: 'CS Circles', u: 'https://cscircles.cemc.uwaterloo.ca/', d: 'University of Waterloo. Short lessons, instant grading.' },
  { t: 'HackInScience', u: 'https://hackinscience.org/', d: 'Free graded Python exercises, from beginner to advanced.' },
  { t: 'CheckiO', u: 'https://py.checkio.org/', d: 'Python puzzles as a game; compare your solution with others after you solve it.' },
  { t: 'Codewars', u: 'https://www.codewars.com/', d: 'Kata by difficulty; good for daily ten-minute practice.' },
  { t: 'Project Euler', u: 'https://projecteuler.net/', d: 'Math-flavored problems; the first twenty are perfect loop practice (Module 2\'s challenge is Problem 10).' },
];

const refs = [
  { t: 'The Python tutorial (official)', u: 'https://docs.python.org/3/tutorial/' },
  { t: 'W3Schools Python reference', u: 'https://www.w3schools.com/python/' },
  { t: 'Whirlwind Tour of Python — free book', u: 'https://jakevdp.github.io/WhirlwindTourOfPython/' },
  { t: 'Automate the Boring Stuff — free book', u: 'https://automatetheboringstuff.com/' },
  { t: 'Python for Data Analysis, 3e — free book', u: 'https://wesmckinney.com/book/' },
  { t: 'Python Data Science Handbook — free book', u: 'https://jakevdp.github.io/PythonDataScienceHandbook/' },
  { t: 'Google\'s Python Class', u: 'https://developers.google.com/edu/python' },
  { t: 'pandas cheat sheet (PDF)', u: 'https://pandas.pydata.org/Pandas_Cheat_Sheet.pdf' },
  { t: 'Matplotlib cheat sheets', u: 'https://matplotlib.org/cheatsheets/' },
];

const kindLabel: Record<string, string> = { slides: 'Slides', lecture: 'Notebook', exercise: 'Exercises', challenge: 'Challenge', web: 'Interactive', video: 'Video', read: 'Reading' };
const kindClass: Record<string, string> = { slides: 'text-accent-purple', lecture: 'text-accent-cyan', exercise: 'text-accent-green', challenge: 'text-accent-orange', web: 'text-accent-cyan', video: 'text-accent-magenta', read: 'text-text-muted' };
---

<BaseLayout title="ISOM 835 | Python Track" description="A self-paced Python track for ISOM 835: a guided in-browser course from your first variable to your first model, Prof. Arslan's ISOM 730 modules for depth, and the best free resources on the web.">
  <section class="py-24 px-8 max-w-[1100px] mx-auto">
    <div class="font-mono text-[0.75rem] text-accent-cyan tracking-[3px] uppercase mb-6">Python Track · self-paced · free</div>
    <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-tight mb-6">Python for <GradientText>Predictive Analytics</GradientText></h1>
    <p class="text-text-secondary text-xl max-w-[820px] leading-relaxed mb-6">
      ISOM 835 assumes you can read and write basic Python and pandas. This track gets you there — or back there — in about twenty hours, at your own pace. Start with <b class="text-text-primary">Python, Guided</b>: seven lessons you read, run, and get graded on without leaving the page. Then go deeper with Prof. Arslan's ISOM 730 modules — slides, lecture notebooks, exercises, and a challenge for every level — and the best free resources on the web.
    </p>
    <div class="flex gap-4 flex-wrap">
      <a href="/python/playground/" class="px-8 py-4 bg-gradient-to-r from-accent-cyan to-accent-purple rounded-full text-bg-primary font-semibold no-underline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_10px_40px_rgba(46,230,197,0.3)]">Start Python, Guided →</a>
      <a href="#levels" class="px-8 py-4 border border-border-subtle rounded-full text-text-primary no-underline transition-all duration-300 hover:border-accent-cyan hover:text-accent-cyan">See the levels</a>
    </div>
  </section>

  <section class="px-8 max-w-[1100px] mx-auto mb-8">
    <div class="grid md:grid-cols-3 gap-4">
      {[['Never coded', 'Levels 0 → 6 in order, one level per sitting. Budget three weeks; finish Level 4 before Session 2.'], ['Rusty', 'Do the Playground in one evening. Wherever you stumble, open that level\'s exercises.'], ['Comfortable', 'Skip to Level 4 (pandas) and Level 6 (first scikit-learn), then start Session 1.']].map(([t, d]) => (
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5"><div class="font-mono text-[0.68rem] text-accent-cyan tracking-[2px] uppercase mb-2">If you are… {t}</div><div class="text-sm text-text-secondary leading-relaxed">{d}</div></div>
      ))}
    </div>
  </section>

  <section id="levels" class="py-12 px-8 max-w-[1100px] mx-auto">
    <SectionHeader number="01" label="The track" title="Seven levels, one notebook habit" description="Each level: what you will be able to do, Prof. Arslan's slides and notebooks, exercises and a challenge, and the two or three outside resources worth your time." />
    <div class="grid gap-8">
      {levels.map((L) => (
        <div class="bg-bg-card border border-border-subtle rounded-2xl p-7 fade-in" id={`level-${L.n}`}>
          <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
            <div class="flex items-center gap-4">
              <div class="font-mono text-3xl font-bold bg-gradient-to-br from-accent-cyan to-accent-purple bg-clip-text text-transparent">{L.n}</div>
              <Icon name={L.icon} class="w-6 h-6 text-accent-purple" />
              <h2 class="text-xl font-bold">{L.title}</h2>
            </div>
            <span class="font-mono text-[0.7rem] text-text-muted border border-border-subtle rounded-full px-3 py-1">{L.time}</span>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed mb-5 max-w-[860px]">{L.blurb}</p>
          <div class="grid md:grid-cols-[1fr_1.4fr] gap-6">
            <div>
              <div class="font-mono text-[0.68rem] text-accent-cyan tracking-[2px] uppercase mb-2">After this level you can</div>
              <ul class="space-y-2">{L.can.map((c) => (<li class="flex gap-2 text-sm text-text-secondary leading-relaxed"><Icon name="check" class="w-4 h-4 text-accent-green shrink-0 mt-0.5" /><span>{c}</span></li>))}</ul>
              <div class="mt-4 text-sm text-text-muted"><b class="text-text-secondary">Practice:</b> {L.practice}</div>
            </div>
            <div>
              <div class="font-mono text-[0.68rem] text-accent-cyan tracking-[2px] uppercase mb-2">Materials</div>
              <ul class="grid gap-2">
                {L.links.map((l) => (
                  <li><a href={l.u} target="_blank" rel="noopener" class="flex gap-3 items-start bg-bg-tertiary/40 border border-border-subtle rounded-lg px-4 py-2.5 no-underline hover:border-accent-cyan/40 transition-colors">
                    <span class={`font-mono text-[0.62rem] tracking-[1px] uppercase w-[74px] shrink-0 mt-1 ${kindClass[l.k]}`}>{kindLabel[l.k]}</span>
                    <span><span class="text-sm text-text-primary">{l.t}</span>{l.d && <span class="block text-[0.8rem] text-text-muted leading-relaxed">{l.d}</span>}</span>
                  </a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 px-8 max-w-[1100px] mx-auto">
    <SectionHeader number="02" label="Practice arenas" title="Where to get your reps" description="Programming is a motor skill. Ten minutes a day in one of these beats three hours on a Sunday." />
    <div class="grid md:grid-cols-2 gap-4">
      {arenas.map((a) => (<a href={a.u} target={a.u.startsWith('http') ? '_blank' : undefined} rel="noopener" class="flex gap-4 bg-bg-card border border-border-subtle rounded-xl p-5 no-underline transition-all duration-300 hover:border-accent-cyan/30 hover:translate-x-1 fade-in"><Icon name="zap" class="w-5 h-5 text-accent-cyan shrink-0 mt-0.5" /><div><div class="font-semibold text-text-primary mb-1">{a.t}</div><div class="text-sm text-text-secondary leading-relaxed">{a.d}</div></div></a>))}
    </div>
  </section>

  <section class="py-12 px-8 max-w-[1100px] mx-auto">
    <SectionHeader number="03" label="References" title="Keep these open" />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 fade-in">
      {refs.map((r) => (<a href={r.u} target="_blank" rel="noopener" class="bg-bg-card border border-border-subtle rounded-xl px-5 py-4 no-underline text-sm text-text-primary hover:border-accent-cyan/30 transition-colors flex items-center gap-3"><Icon name="book-open" class="w-4 h-4 text-accent-purple shrink-0" />{r.t}</a>))}
    </div>
    <p class="text-text-muted text-sm mt-6">Slide decks are Google Slides (view-only). Notebooks marked "Prof. Arslan" open in Colab from this course's repository; Fall 2025 lecture Colabs open from Drive. Everything here is free.</p>
  </section>

  <section class="py-12 px-8 max-w-[1100px] mx-auto">
    <SectionHeader number="04" label="Idioms" title="Six lines you will type all semester" />
    <div class="grid md:grid-cols-2 gap-4 fade-in">
      {[
        ['Count things', 'counts[key] = counts.get(key, 0) + 1'],
        ['Clean a money column', "df['price'] = df['price'].str.replace('[$,]', '', regex=True).astype(float)"],
        ['Rate by group', "df.groupby('contract')['churn'].mean().sort_values(ascending=False)"],
        ['Coerce text to numbers, safely', "pd.to_numeric(df['TotalCharges'], errors='coerce')"],
        ['Filter and pick columns', "df.loc[df['tenure'] < 12, ['customerID', 'MonthlyCharges']]"],
        ['Read from a URL', "pd.read_csv('https://raw.githubusercontent.com/harslan/isom-835/master/public/data/telco_churn.csv')"],
      ].map(([t, c]) => (<div class="bg-bg-card border border-border-subtle rounded-xl p-5"><div class="font-mono text-[0.68rem] text-accent-cyan tracking-[2px] uppercase mb-2">{t}</div><code class="font-mono text-[0.8rem] text-text-secondary break-all">{c}</code></div>))}
    </div>
  </section>
</BaseLayout>
